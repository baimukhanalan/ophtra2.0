{
  "name": "ophtra-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OPHTRA API — booking, CRM, MIS, WhatsApp, payments, assistant and admin services.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "rm -f data/ophtra.db && npm run db:seed",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2"
  }
}
